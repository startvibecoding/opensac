{
  "name": "opensac",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "start": "deno run -A src/main.ts",
    "run": "deno task start",
    "version": "deno run -A scripts/version.ts",
    "gen:worker-sources": "deno run -A scripts/gen_worker_sources.ts",
    "build:node": "deno run -A scripts/build_node.ts",
    "pack:node": "deno run -A scripts/build_node.ts && deno run -A scripts/pack_node.ts",
    "publish:node": "deno run -A scripts/npm_publish_if_needed.ts --tag latest dist/node",
    "install": "deno install -g -A -n opensac -f --config deno.json src/main.ts",
    "test": "deno test -A",
    "test:architecture": "deno test -A src/architecture/",
    "check": "deno check src/ sdk/ examples/ scripts/ bootstrap.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "fuzz": "deno test -A --filter fuzz src/esm src/mcp src/util"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "exclude": [
      "*.md",
      "docs/",
      ".opensac/",
      ".mothx/",
      "skills/",
      "bin/",
      "dist/",
      "src/platform/busybox_assets/",
      "src/context/tokenizerdata/",
      "src/expert/builtin/",
      "src/stats/dashboard.html",
      "src/skills/builtin/",
      "src/util/regex_worker_source.ts",
      "src/workflow/js_worker_source.ts"
    ]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": [
      ".opensac/",
      ".mothx/",
      "skills/",
      "bin/",
      "dist/",
      "src/platform/busybox_assets/",
      "src/context/tokenizerdata/",
      "src/expert/builtin/",
      "src/skills/builtin/"
    ]
  },
  "compilerOptions": {
    "strict": true,
    "jsx": "react",
    "lib": ["deno.window", "dom", "dom.iterable", "esnext"]
  },
  "imports": {
    "@opensac/path": "./src/compat/path.ts",
    "@opensac/path/posix": "./src/compat/path_posix.ts",
    "@opensac/assert": "./src/compat/assert.ts",
    "@opensac/encoding/base64": "./src/compat/encoding.ts",
    "@opensac/encoding/base64url": "./src/compat/encoding.ts",
    "ink": "npm:ink@^5",
    "react": "npm:react@^18",
    "react/": "npm:/react@^18/",
    "@types/react": "npm:@types/react@^18",
    "@types/react/": "npm:/@types/react@^18/",
    "imagescript": "npm:imagescript@^1",
    "@jsquash/webp": "npm:@jsquash/webp@^1",
    "ws": "npm:ws@^8",
    "undici": "npm:undici@^6",
    "@deno/shim-deno": "npm:@deno/shim-deno@~0.18.0"
  }
}
