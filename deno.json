{
  "name": "mothx",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "run": "deno task build && ./bin/mothx",
    "start": "deno run -A src/main.ts",
    "build": "deno compile -A --include src/platform/busybox_assets --include src/context/tokenizerdata --include src/stats/dashboard.html --include src/stats/mothx.png --include src/stats/mothx-small.ico --include src/skills/builtin -o bin/mothx src/main.ts",
    "serve": "deno task ui-build && deno task build && ./bin/mothx serve",
    "install": "deno install -g -A -n mothx src/main.ts",
    "test": "deno test -A",
    "test:architecture": "deno test -A src/architecture/",
    "check": "deno check src/",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "fuzz": "deno test -A --filter fuzz src/esm src/mcp src/util",
    "ui-install": "cd ui && npm ci",
    "ui-build": "cd ui && npm run build",
    "ui-dev": "cd ui && npm run dev",
    "ui-preview": "cd ui && npm run preview"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "exclude": [
      "*.md",
      "docs/",
      "bin/",
      "dist/",
      "ui/dist/",
      "ui/node_modules/",
      "src/platform/busybox_assets/",
      "src/context/tokenizerdata/",
      "src/stats/dashboard.html",
      "src/skills/builtin/"
    ]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": [
      "bin/",
      "dist/",
      "ui/dist/",
      "ui/node_modules/",
      "src/platform/busybox_assets/",
      "src/context/tokenizerdata/",
      "src/skills/builtin/"
    ]
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom", "dom.iterable", "esnext"]
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/async": "jsr:@std/async@^1",
    "@std/encoding": "jsr:@std/encoding@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/io": "jsr:@std/io@^0.225",
    "@std/streams": "jsr:@std/streams@^1",
    "@std/collections": "jsr:@std/collections@^1",
    "@std/yaml": "jsr:@std/yaml@^1",
    "@std/crypto": "jsr:@std/crypto@^1",
    "@std/http": "jsr:@std/http@^1",
    "@db/sqlite": "jsr:@db/sqlite@^0.12",
    "@cliffy/command": "jsr:@cliffy/command@^1",
    "ink": "npm:ink@^5"
  }
}
