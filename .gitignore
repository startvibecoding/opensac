# Deno
.deno/
deno.lock.bak
coverage/

# Leftover rule file from the Go source project this was ported from; it is
# user-local context, not part of the OpenSAC tree.
.mothx/

# Build output
bin/
dist/
ui/dist/

# Generated npm packages. The manifests under npm/packages/ and the entry
# package's bin/ wrapper are rebuilt by `make npm-packages`; only the hand-written
# sources in npm/ (package.json, .npmignore, README.md) are tracked.
npm/packages/
npm/bin/
npm/scripts/

# Node (present only if npm packages are used)
node_modules/
ui/node_modules/
desktop/node_modules/

# Editors / OS
.DS_Store
.idea/
.vscode/
